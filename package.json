{
  "name": "chatgpt-swarm",
  "version": "0.1.1",
  "private": true,
  "description": "Turn ChatGPT Project conversations into lightweight multi-agent swarm workflows",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "prepare": "wxt prepare",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/ *.config.ts",
    "lint:fix": "eslint src/ tests/ *.config.ts --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' '*.config.ts' '*.md' 'docs/**/*.md' '.github/**/*.md' '.github/**/*.yml'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' '*.config.ts' '*.md' 'docs/**/*.md' '.github/**/*.md' '.github/**/*.yml'",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test",
    "verify": "npm run check && npm run build && npm run test:e2e && npm audit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vyas-devgna/chatgpt-swarm.git"
  },
  "keywords": [
    "chatgpt",
    "swarm",
    "multi-agent",
    "browser-extension",
    "chrome-extension"
  ],
  "author": "vyas-devgna",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/vyas-devgna/chatgpt-swarm/issues"
  },
  "homepage": "https://github.com/vyas-devgna/chatgpt-swarm#readme",
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.0",
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "valibot": "^1.4.2",
    "vitest": "^5.0.0",
    "wxt": "^0.21.4"
  }
}
