{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "types": ["chrome", "vitest/globals"],
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "wxt.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    ".wxt/wxt.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".output",
    "dist"
  ]
}
